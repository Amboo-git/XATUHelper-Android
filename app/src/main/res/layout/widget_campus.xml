<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="XATune" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_text" />
<TextView android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="点击打开校园助手" android:textSize="17sp" android:maxLines="7" android:ellipsize="end" android:textColor="@color/widget_text" />
<TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="本地缓存" android:textSize="11sp" android:maxLines="2" android:textColor="@color/widget_text" />
<TextView android:id="@+id/widget_action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="36dp" android:gravity="center_vertical" android:text="打开" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_text" />
</LinearLayout>